# =======================================================
# GymPro — Apache Security & Directory Configuration
# =======================================================

# 1. Disable directory browsing safely
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# 2. Block direct web access to sensitive environment, sql, and config files
<FilesMatch "^(\.env|\.env\..*|schema\.sql|.*\.sql|.*\.log|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. UTF-8 Character Encoding
AddDefaultCharset UTF-8
